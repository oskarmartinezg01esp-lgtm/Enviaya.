# ---------- Base de datos ----------
DATABASE_URL="postgresql://cortana:cortana@localhost:5432/cortana?schema=public"
APP_URL="http://localhost:3000"

# ---------- IA (opcional) ----------
# Sin clave, CORTANA usa su motor conversacional local + voz del navegador (Web Speech API).
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4.1-mini"        # razonamiento + tool calling (modo texto)
OPENAI_REALTIME_MODEL="gpt-realtime"    # voz en tiempo real por WebRTC
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
AI_ENGINE=""                            # "local" para forzar el motor local aunque haya clave

# ---------- Autenticación Google (opcional) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Pagos: Stripe (opcional; sin clave = modo demostración) ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------- Notificaciones (opcional) ----------
RESEND_API_KEY=""
EMAIL_FROM="CORTANA <pedidos@tudominio.com>"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ---------- Negocio ----------
DELIVERY_FEE_CENTS="0"
FREE_DELIVERY_FROM_CENTS="0"
# Simula cocina/reparto avanzando el estado de los pedidos con el tiempo (demo)
SIMULATE_ORDER_PROGRESS="true"
